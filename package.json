{
  "name": "beeper-alfred",
  "version": "1.0.0",
  "description": "Alfred workflow for Beeper Desktop - Search messages, send messages, and manage chats across all messaging networks",
  "main": "src/index.js",
  "scripts": {
    "test": "jest --coverage",
    "test:unit": "jest",
    "test:watch": "jest --watch",
    "test:ci": "npm run lint && npm test",
    "test:local": "./scripts/test-local.sh",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "build": "node scripts/build-workflow.js",
    "generate-icons": "node scripts/generate-icons.js",
    "dev": "node src/index.js",
    "prepare": "npm run lint",
    "precommit": "npm run lint && npm test",
    "commitlint": "commitlint --edit",
    "commitlint:check": "commitlint --from HEAD~1 --to HEAD --verbose"
  },
  "keywords": [
    "alfred",
    "workflow",
    "beeper",
    "messaging",
    "whatsapp",
    "telegram",
    "signal"
  ],
  "author": "deletosh",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.4.2",
    "archiver": "^6.0.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/deletosh/beeper-alfred"
  }
}
